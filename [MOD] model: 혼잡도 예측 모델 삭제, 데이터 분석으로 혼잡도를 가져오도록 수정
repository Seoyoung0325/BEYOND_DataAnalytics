        "    target      = 'best',          # 쾌적도 최하위 경로 기준\n",
        ")\n",
        "\n",
        "print(\"\\n추천 출발시간:\", result[\"optimal_time\"])\n",
        "print(\"예상 총 혼잡도:\", result[\"min_congestion\"])\n",
        "result[\"all_results\"]"
      ]
