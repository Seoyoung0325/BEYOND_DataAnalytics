        "# 이동편의시설 지수 계산\n",
        "\n",
        "# 희귀도 기반 가중치 설정  (전체 역 중 보유 비율이 낮을수록 = 있을 때 더 큰 혜택)\n",
        "total = len(facility_df)\n",
