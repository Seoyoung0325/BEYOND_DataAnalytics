    {
      "cell_type": "code",
      "source": [
        "df_model = df[~zero_or_na].copy()\n",
        "print(f'유효 데이터: {len(df_model):,}행')\n",
        "\n",
        "# (station_key, 상하구분, 요일구분, time_minutes) → 혼잡도 평균\n",
        "lookup_table = (\n",
        "    df_model\n",
        "    .groupby(['station_key', '상하구분', '요일구분', 'time_minutes'])['혼잡도']\n",
        "    .mean()\n",
        "    .round(1)\n",
        "    .to_dict()\n",
        ")\n",
        "print(f'lookup 테이블 항목 수: {len(lookup_table):,}개')"
