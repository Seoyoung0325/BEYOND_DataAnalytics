      "source": [
        "plt.rcParams['axes.unicode_minus'] = False  # 마이너스 기호 깨짐 방지 (한글 폰트 사용시 필수)\n",
        "\n",
        "# 실제 서울 지하철 노선도 색상 (발표자료 신뢰도를 위해 실제 색상 사용)\n",
        "LINE_COLORS = {\n",
        "    '1호선': '#0052A4', '2호선': '#00A84D', '3호선': '#EF7C1C',\n",
        "    '4호선': '#00A5DE', '5호선': '#996CAC', '6호선': '#CD7C2F',\n",
        "    '7호선': '#747F00', '8호선': '#E6186C', '9호선': '#BDB092',\n",
        "}\n",
        "def get_line_color(line):\n",
        "    return LINE_COLORS.get(line, '#888888')\n",
        "\n",
        "# Percentile x Z-score 산점도 (혼잡 판정 로직/방법론 설명용)\n",
        "def plot_percentile_zscore_scatter(df_model, day_type, slot,\n",
        "                                   top_percentile=90.0, z_threshold=1.5, save_path=None):\n",
        "    snapshot = df_model[\n",
        "        (df_model['요일구분'] == day_type) &\n",
        "        (df_model['time_minutes'] == slot) &\n",
        "        (df_model['혼잡도'] > 0)\n",
        "    ].copy()\n",
        "    snapshot['percentile'] = snapshot['혼잡도'].rank(pct=True) * 100\n",
        "\n",
        "    station_stats = (\n",
        "        df_model[(df_model['요일구분'] == day_type) & (df_model['혼잡도'] > 0)]\n",
        "        .groupby(['호선', '출발역', '상하구분'])['혼잡도']\n",
        "        .agg(평소평균='mean', 평소표준편차='std')\n",
        "        .reset_index()\n",
        "    )\n",
        "    snapshot = snapshot.merge(station_stats, on=['호선', '출발역', '상하구분'], how='left')\n",
        "    snapshot['z_score'] = (snapshot['혼잡도'] - snapshot['평소평균']) / snapshot['평소표준편차'].replace(0, np.nan)\n",
        "\n",
        "    is_congested = (snapshot['percentile'] >= top_percentile) | (snapshot['z_score'] >= z_threshold)\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(9, 6))\n",
        "    ax.scatter(snapshot.loc[~is_congested, 'percentile'], snapshot.loc[~is_congested, 'z_score'],\n",
        "               color='#CCCCCC', s=20, label='일반')\n",
        "    ax.scatter(snapshot.loc[is_congested, 'percentile'], snapshot.loc[is_congested, 'z_score'],\n",
        "               color='#E6186C', s=35, label='혼잡 판정')\n",
        "\n",
        "    ax.axvline(top_percentile, color='#0052A4', linestyle='--', linewidth=1,\n",
        "               label=f'상위 {100 - top_percentile:.0f}% 기준선')\n",
        "    ax.axhline(z_threshold, color='#996CAC', linestyle='--', linewidth=1,\n",
        "               label=f'z-score {z_threshold} 기준선')\n",
        "\n",
        "    ax.set_xlabel('percentile (전체 역 대비 상대 순위, %)')\n",
        "    ax.set_ylabel('z-score (역 자체 평소 대비 표준편차)')\n",
        "    ax.set_title('혼잡 판정 로직: Percentile × Z-score', fontsize=14, fontweight='bold')\n",
        "    ax.legend(fontsize=9, loc='upper left')\n",
        "    ax.spines[['top', 'right']].set_visible(False)\n",
        "    plt.tight_layout()\n",
        "\n",
        "    if save_path:\n",
        "        plt.savefig(save_path, dpi=200, bbox_inches='tight')\n",
        "        print(f'저장 완료: {save_path}')\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "# ── 실행: 발표자료용 4종 차트 생성 및 저장 ──────────────────────────────\n",
        "congested, line_ranking, day_type, slot = analyze_current_congestion(df_model)\n",
        "plot_percentile_zscore_scatter(df_model, day_type, slot)"
      ]
