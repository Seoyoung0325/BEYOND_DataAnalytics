        "#착석가능지수 계산 함수\n",
        "def get_seating_score(congestion):\n",
        "    # ① 예외 처리: 예측값이 없으면(None) 똑같이 None 반환하여 에러 방지\n",
        "    if congestion is None:\n",
        "        return None\n",
        "\n",
        "    # ② 전원 착석 구간: 혼잡도 33.8% 이하 ➔ 무조건 1\n",
        "    if congestion <= 33.8:\n",
        "        return 1.0\n",
        "\n",
        "    # ③ 착석 비율 계산: 혼잡도가 높을수록 점수가 비례해서 감소\n",
        "    return round(33.8 / congestion,3)"
      ]
