        "# 시간대 문자열 -> 분 단위 정수 변환\n",
        "def parse_time_to_minutes(t):\n",
        "    t = t.strip()\n",
        "    if '시30분' in t:\n",
        "        h = int(t.replace('시30분', ''))\n",
        "        m = 30\n",
        "    else:\n",
        "        h = int(t.replace('시00분', ''))\n",
        "        m = 0\n",
        "    total = h * 60 + m\n",
        "    if total < 330:  # 자정~새벽 보정\n",
        "        total += 1440\n",
        "    return total\n",
        "\n",
        "df['time_minutes'] = df['시간대'].apply(parse_time_to_minutes)\n",
        "\n",
        "# 요일 피처\n",
